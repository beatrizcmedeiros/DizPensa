# Copie para .env e preencha com os dados do seu projeto.
# Supabase: Project Settings > API (URL e "publishable key")
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxx

# PowerSync: URL da instância (painel do PowerSync > Connect)
EXPO_PUBLIC_POWERSYNC_URL=https://xxxxxxxx.powersync.journeyapps.com
